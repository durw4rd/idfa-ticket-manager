# Copy to .env.local and fill in. See README.md for what each one does.

# Auth (NextAuth + Google OAuth)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Postgres (Neon)
DATABASE_URL=

# Vercel Blob (private store)
PRIVATE_BLOB_READ_WRITE_TOKEN=

# AI providers
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LaunchDarkly
LD_SDK_KEY=
# LD_SERVICE_NAME=idfa-manager

# Sign-in allowlist used only when LaunchDarkly is unreachable
ALLOWED_EMAILS=

# Pretend "now" is this date (testing only)
# TEST_DATE=2026-11-14T14:00:00Z
